# Server-only credentials. Never use a VITE_ prefix for these values.
DATABASE_URL=
SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_NAME=BrightByte Admin
ADMIN_EMAIL=admin@brightbyte.io
ADMIN_PASSWORD=
# Exact production website origin, e.g. https://brightbyte.io
APP_ORIGIN=
PORT=4000
HOST=127.0.0.1
# Enable only behind one trusted reverse proxy.
TRUST_PROXY=0
# Optional PUBLIC API origin. Empty means same-origin /api.
VITE_API_BASE_URL=
# Brevo transactional API (server only; verified sender required)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BrightByte

# Optional stable server-only secret for encrypting shared mail credentials.
# Set before saving an API key; otherwise SESSION_SECRET is used.
MAIL_ENCRYPTION_KEY=
